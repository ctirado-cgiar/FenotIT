digraph G {
  graph [rankdir=TB, fontname="Helvetica", fontsize=11, nodesep=0.5, ranksep=0.7, pad=0.3, splines=spline, newrank=true,
         label=<<b>Component diagram for the FenotIT desktop application</b><br/><font point-size="10">C4 model, level 3 (components). Arrows read in their direction.</font>>, labelloc=t, labeljust=l];
  node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=10, color="#3C7FC0", fillcolor="#85BBF0", fontcolor="#000000", margin="0.15,0.08", width=2.5];
  edge [fontname="Helvetica", fontsize=9, color="#707070", fontcolor="#505050", arrowsize=0.7, penwidth=1.1];

  user [fillcolor="#08427B", color="#052E56", fontcolor="#FFFFFF",
        label=<<b>Plant scientist or breeder</b><br/><font point-size="8">[Person]</font><br/><br/>Photographs samples and obtains<br/>trait tables without programming>];

  subgraph cluster_app {
    label=<<b>FenotIT desktop application</b><br/><font point-size="9">[Container: Python 3.12, tkinter]</font>>;
    labeljust=l; style="dashed,rounded"; color="#444444"; fontname="Helvetica"; fontsize=11; margin=18;

    gui [label=<<b>Main window</b><br/><font point-size="8">[Component: tkinter]</font><br/><br/>Photo list, input and result views,<br/>Segment and Analyze panels, charts>];
    batch [label=<<b>Batch runner</b><br/><font point-size="8">[Component: ProcessPoolExecutor]</font><br/><br/>Analyzes photos in parallel<br/>worker processes; cancellable>];
    stats [label=<<b>Statistics</b><br/><font point-size="8">[Component: NumPy]</font><br/><br/>Joins results with the user table;<br/>group summaries, mean shapes>];
    project [label=<<b>Project</b><br/><font point-size="8">[Component: dataclass, YAML]</font><br/><br/>Photos, areas, scale, corrections,<br/>segmentation and parameters>];
    export [label=<<b>Exporter</b><br/><font point-size="8">[Component: csv, openpyxl]</font><br/><br/>One table per level, workbook,<br/>metadata, annotated views>];
    corr [label=<<b>Corrections</b><br/><font point-size="8">[Component: OpenCV]</font><br/><br/>Lens distortion, perspective (ArUco),<br/>color card, scale, working resolution>];
    engine [label=<<b>Pipeline engine</b><br/><font point-size="8">[Component: Python]</font><br/><br/>Runs a chain of steps on a shared<br/>context; caches the common prefix>];
    seg [label=<<b>Segmentation</b><br/><font point-size="8">[Component: steps]</font><br/><br/>Threshold, pixel classifier trained<br/>on strokes, MobileSAM; mask refinement>];
    meas [label=<<b>Objects and measurements</b><br/><font point-size="8">[Component: steps]</font><br/><br/>Separation, filters; count, size,<br/>shape, color, classes, distances>];
  }

  libs [fillcolor="#999999", color="#6B6B6B", fontcolor="#FFFFFF",
        label=<<b>Scientific Python stack</b><br/><font point-size="8">[Software system]</font><br/><br/>OpenCV, NumPy, SciPy, scikit-image,<br/>scikit-learn, Matplotlib, Pillow>];
  onnx [fillcolor="#999999", color="#6B6B6B", fontcolor="#FFFFFF",
        label=<<b>Trained models</b><br/><font point-size="8">[ONNX Runtime]</font><br/><br/>MobileSAM; user models for<br/>detection and segmentation>];
  fs [fillcolor="#999999", color="#6B6B6B", fontcolor="#FFFFFF",
      label=<<b>File system</b><br/><font point-size="8">[Storage]</font><br/><br/>Photos, project folder (.fenotit),<br/>exported results>];

  user -> gui [label="  selects photos, segments,\n  chooses analyses"];
  gui -> batch [label="  starts batch,\n  receives light results"];
  gui -> engine [label="  analyzes the current photo\n  [background thread]"];
  gui -> stats [label="  groups results\n  for charts"];
  gui -> project [label="  reads and edits"];
  gui -> export [label="  exports on request"];
  batch -> corr [label="  corrects each photo"];
  batch -> engine [label="  analyzes each photo\n  [worker process]"];
  engine -> seg [label="  step 1"];
  engine -> meas [label="  step 2"];
  seg -> onnx [label="  runs models"];
  seg -> libs [label="  image processing,\n  random forest"];
  meas -> libs;
  project -> fs [label="  saves and opens YAML"];
  export -> fs [label="  writes CSV, XLSX, PNG"];

  { rank=same; batch; engine; stats; project; export; }
  { rank=same; corr; seg; meas; }
  { rank=same; libs; onnx; fs; }
  batch -> engine -> stats -> project -> export [style=invis];
  corr -> seg -> meas [style=invis];
  onnx -> libs -> fs [style=invis];
}
